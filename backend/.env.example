PORT=3000
API_TOKEN=change-me
# Tashqi MQTT broker (bo'sh qoldirsangiz o'rnatilgan Aedes broker ishlaydi, port 1883)
MQTT_URL=
MQTT_PORT=1883
# Qurilmalar yo'q bo'lsa simulyator (true/false)
SIMULATE=true
# 1 kWh narxi (so'm). Haqiqiy tarifingizga moslang.
TARIFF_UZS_PER_KWH=1000
# Uyning umumiy quvvat chegarasi (Vatt). Masalan 32A * 220V ~ 7000W
MAX_TOTAL_WATTS=7000
